# Settings CalmConnect reads from the environment. Export them in your shell,
# or put them in .env for docker compose to pick up.

# Where the database, secret key and CLI login are kept. Defaults to ./data.
# CALMCONNECT_DATA_DIR=data

# Signs web session cookies. If unset, a random key is generated once and
# saved in the data directory.
# CALMCONNECT_SECRET_KEY=

# Set to 1 when serving over HTTPS so session cookies are only sent securely.
# CALMCONNECT_SECURE_COOKIES=0
